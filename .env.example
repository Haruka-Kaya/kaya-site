# Keystatic GitHub OAuth (本番環境・Vercelに設定)
# github.com/settings/developers → OAuth Apps から取得
KEYSTATIC_GITHUB_CLIENT_ID=
KEYSTATIC_GITHUB_CLIENT_SECRET=
KEYSTATIC_SECRET=

# Temporary sharing: a SHA-256 digest of a randomly generated password (never the password itself)
SHARE_PASSWORD_HASH=
SHARE_SESSION_SECRET=
BLOB_READ_WRITE_TOKEN=
