---
interface Props {
  id: string;
  eyebrow: string;
  heading: string;
  intro?: string;
}

const { id, eyebrow, heading, intro } = Astro.props;
---

<div class="section-header">
  <div data-reveal>
    <p class="eyebrow">{eyebrow}</p>
    <h2 id={id} class="section-heading">{heading}</h2>
  </div>
  <div class="section-header-side" data-reveal style="--reveal-delay: 120ms">
    {intro && <p class="section-intro">{intro}</p>}
    <slot />
  </div>
</div>

<style>
  .section-header {
    display: grid;
    gap: 1.5rem;
    margin-bottom: clamp(2.5rem, 5vw, 4rem);
  }

  .section-header-side {
    display: grid;
    gap: 1.25rem;
    align-content: end;
    justify-items: start;
  }

  @media (min-width: 48rem) {
    .section-header {
      grid-template-columns: minmax(0, 1fr) minmax(18rem, 0.8fr);
      align-items: end;
      gap: 4rem;
    }

    .section-intro {
      margin: 0;
    }
  }
</style>
