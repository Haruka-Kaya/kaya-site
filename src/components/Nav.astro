---
interface Props {
  name: string;
  github?: string;
}

const { name } = Astro.props;
---

<header class="site-header">
  <nav class="container site-nav" aria-label="メインナビゲーション">
    <a class="site-name" href="/" aria-label={`${name}のトップページ`}>
      <span class="site-name-mark" aria-hidden="true">HK</span>
      <span>{name}</span>
    </a>

    <div class="nav-links">
      <a href="/#security">セキュリティ</a>
      <a href="/#projects">作ったもの</a>
      <a href="/#about">自己紹介</a>
      <a href="/#likes">好きなこと</a>
    </div>

    <a class="contact-link" href="/#contact">連絡先</a>
  </nav>
</header>

<style>
  .site-header {
    position: sticky;
    z-index: 50;
    top: 0;
    border-bottom: 1px solid var(--line);
    background: var(--paper);
  }

  .site-nav {
    display: flex;
    min-height: 4.5rem;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .site-name {
    display: inline-flex;
    min-width: 0;
    align-items: center;
    gap: 0.65rem;
    font-weight: 700;
    line-height: 1.3;
    text-decoration: none;
  }

  .site-name-mark {
    display: grid;
    width: 2.25rem;
    height: 2rem;
    flex: 0 0 auto;
    place-items: center;
    border-radius: var(--radius-sm);
    background: var(--security);
    color: var(--signal);
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 0.8rem;
  }

  .nav-links {
    display: none;
    align-items: center;
    gap: 1.5rem;
    color: var(--muted);
    font-size: 0.9rem;
  }

  .nav-links a,
  .contact-link {
    min-height: 2.75rem;
    align-items: center;
    text-decoration: none;
  }

  .nav-links a {
    display: inline-flex;
  }

  .nav-links a:hover {
    color: var(--accent-strong);
  }

  .contact-link {
    display: inline-flex;
    flex: 0 0 auto;
    padding-inline: 0.9rem;
    border: 1px solid var(--accent);
    border-radius: var(--radius-md);
    color: var(--accent-strong);
    font-size: 0.9rem;
    font-weight: 700;
  }

  .contact-link:hover {
    background: var(--accent-soft);
  }

  @media (min-width: 46rem) {
    .nav-links {
      display: flex;
    }
  }
</style>
