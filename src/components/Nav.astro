---
interface Props {
  name: string;
  github: string;
}
const { name, github } = Astro.props;
const initials = name.split(' ').map(n => n[0]).join('');
---

<header style="position:fixed;top:0;left:0;right:0;z-index:50;background-color:rgba(17,17,17,0.85);backdrop-filter:blur(12px);border-bottom:1px solid var(--border);">
  <nav class="container" style="height:60px;display:flex;align-items:center;justify-content:space-between;">
    <a href="/" style="font-family:'JetBrains Mono',monospace;font-size:0.85rem;font-weight:600;color:var(--text);">
      {initials.toLowerCase()}<span style="color:var(--accent)">.</span>dev
    </a>
    <div style="display:flex;align-items:center;gap:1.5rem;">
      <a href="#about" class="nav-link">About</a>
      <a href="#hobbies" class="nav-link">Hobbies</a>
      <a href="#projects" class="nav-link">Projects</a>
      <button id="lang-toggle" aria-label="Switch language" title="Switch language">
        <span class="lang-ja">EN</span>
        <span class="lang-en">JP</span>
      </button>
      {github && (
        <a href={github} target="_blank" rel="noopener" class="btn-ghost" style="padding:0.4rem 0.875rem;font-size:0.8rem;">
          GitHub
        </a>
      )}
    </div>
  </nav>
</header>

<script is:inline>
  (function () {
    var lang = localStorage.getItem('site-lang') || 'ja';
    document.documentElement.setAttribute('data-lang', lang);
  })();
</script>

<script>
  document.getElementById('lang-toggle')?.addEventListener('click', function () {
    var curr = document.documentElement.getAttribute('data-lang') || 'ja';
    var next = curr === 'ja' ? 'en' : 'ja';
    document.documentElement.setAttribute('data-lang', next);
    localStorage.setItem('site-lang', next);
  });
</script>

<style>
  .nav-link {
    font-size: 0.875rem;
    color: var(--muted);
    transition: color 0.15s;
  }
  .nav-link:hover {
    color: var(--text);
  }
  #lang-toggle {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.75rem;
    font-weight: 600;
    padding: 0.3rem 0.55rem;
    background: transparent;
    border: 1px solid var(--border);
    border-radius: 0.375rem;
    color: var(--muted);
    cursor: pointer;
    transition: border-color 0.15s, color 0.15s;
    letter-spacing: 0.05em;
  }
  #lang-toggle:hover {
    border-color: var(--accent);
    color: var(--text);
  }
</style>
