---
import { alternateLang, localizePath, useTranslations, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  name: string;
  alternatePath?: string | null;
  surface?: 'portfolio' | 'tech';
}

const { lang, name, alternatePath, surface = 'portfolio' } = Astro.props;
const t = useTranslations(lang);
const other = alternateLang(lang);
const tech = surface === 'tech';
const home = localizePath(tech ? '/tech' : '/', lang);
const switchHref = localizePath(alternatePath ?? '/', other);

const links = tech ? [
  { href: `${home}#research`, label: lang === 'ja' ? '研究方針' : 'Research' },
  { href: localizePath('/tech/writeups', lang), label: lang === 'ja' ? '技術記事' : 'Technical writing' },
  { href: `${home}#projects`, label: lang === 'ja' ? '開発' : 'Engineering' },
  { href: localizePath('/', lang), label: lang === 'ja' ? 'ポートフォリオ ↗' : 'Portfolio ↗' },
] : [
  { href: `${home}#about`, label: t('nav.about') },
  { href: localizePath('/writeups', lang), label: t('nav.writeups') },
  { href: localizePath('/projects', lang), label: t('nav.projects') },
  { href: `${home}#interests`, label: t('nav.interests') },
  { href: localizePath('/tech', lang), label: lang === 'ja' ? '技術者向け ↗' : 'Tech & research ↗' },
];
---

<header class="site-header" data-header>
  <nav class="container site-nav" aria-label={lang === 'ja' ? 'メインナビゲーション' : 'Main navigation'}>
    <a class="site-name" href={home} aria-label={t('nav.home')}>
      <span class="site-mark" aria-hidden="true">HK</span>
      <span class="site-name-text">{tech ? 'HK / TECH' : name}</span>
    </a>

    <ul class="nav-links">
      {links.map((link) => (
        <li>
          <a href={link.href} data-nav-link>{link.label}</a>
        </li>
      ))}
    </ul>

    <div class="nav-tools">
      <a class="lang-switch" href={switchHref} hreflang={other} lang={other} aria-label={t('nav.switchLangLabel')}>
        <span class="lang-switch-current" aria-hidden="true">{lang.toUpperCase()}</span>
        <span class="lang-switch-sep" aria-hidden="true">/</span>
        <span>{other.toUpperCase()}</span>
      </a>
      <button class="icon-button" type="button" data-theme-toggle aria-label={t('nav.theme')}>
        <svg class="icon-sun" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <circle cx="12" cy="12" r="4" />
          <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
        </svg>
        <svg class="icon-moon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z" />
        </svg>
      </button>
      <a class="button button--primary contact-link" href={`${home}#contact`}>{t('nav.contact')}</a>
      <button class="icon-button menu-button" type="button" data-menu-toggle aria-expanded="false" aria-controls="mobile-menu" aria-label={t('nav.menu')}>
        <span class="menu-lines" aria-hidden="true"><i></i><i></i></span>
      </button>
    </div>
  </nav>

  <div class="mobile-menu" id="mobile-menu" data-menu-panel hidden>
    <div class="container mobile-menu-inner">
      <ul class="mobile-links">
        {links.map((link, index) => (
          <li style={`--i: ${index}`}>
            <a href={link.href}>
              <span class="mono">{String(index + 1).padStart(2, '0')}</span>
              {link.label}
            </a>
          </li>
        ))}
        <li style={`--i: ${links.length}`}>
          <a href={`${home}#contact`}>
            <span class="mono">{String(links.length + 1).padStart(2, '0')}</span>
            {t('nav.contact')}
          </a>
        </li>
      </ul>
      <a class="button button--secondary" href={switchHref} hreflang={other} lang={other}>{t('nav.switchLang')}</a>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    z-index: 50;
    top: 0;
    border-bottom: 1px solid transparent;
    background: transparent;
    transition: background-color 300ms var(--ease-out), border-color 300ms var(--ease-out), backdrop-filter 300ms var(--ease-out);
  }

  .site-header.is-scrolled,
  :global(body.menu-open) .site-header {
    border-color: var(--line);
    background: var(--header-bg);
    backdrop-filter: blur(14px) saturate(140%);
    -webkit-backdrop-filter: blur(14px) saturate(140%);
  }

  .site-nav {
    display: flex;
    min-height: var(--header-h);
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .site-name {
    display: inline-flex;
    min-width: 0;
    align-items: center;
    gap: 0.7rem;
    font-weight: 700;
    line-height: 1.2;
    text-decoration: none;
  }

  .site-mark {
    display: grid;
    width: 2.3rem;
    height: 2.1rem;
    flex: 0 0 auto;
    place-items: center;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-sm);
    background: var(--surface);
    color: var(--signal);
    font-family: var(--font-mono);
    font-size: 0.78rem;
    letter-spacing: 0.04em;
    transition: transform 300ms var(--ease-out), border-color 300ms var(--ease-out);
  }

  .site-name:hover .site-mark {
    border-color: var(--signal);
    transform: rotate(-6deg);
  }

  .nav-links {
    display: none;
    align-items: center;
    gap: 0.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .nav-links a {
    position: relative;
    display: inline-flex;
    min-height: 2.5rem;
    align-items: center;
    padding: 0 0.8rem;
    border-radius: 999px;
    color: var(--muted);
    font-size: 0.9rem;
    font-weight: 500;
    text-decoration: none;
    transition: color 200ms var(--ease-out), background-color 200ms var(--ease-out);
  }

  .nav-links a:hover,
  .nav-links a.is-active {
    background: var(--signal-soft);
    color: var(--ink);
  }

  .nav-tools {
    display: flex;
    flex: 0 0 auto;
    align-items: center;
    gap: 0.5rem;
  }

  .lang-switch {
    display: inline-flex;
    min-height: 2.5rem;
    align-items: center;
    gap: 0.3rem;
    padding: 0 0.75rem;
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-decoration: none;
    transition: border-color 200ms var(--ease-out), color 200ms var(--ease-out);
  }

  .lang-switch-current {
    color: var(--ink);
  }

  .lang-switch-sep {
    opacity: 0.5;
  }

  .lang-switch:hover {
    border-color: var(--signal);
    color: var(--signal);
  }

  .icon-button {
    display: grid;
    width: 2.5rem;
    height: 2.5rem;
    place-items: center;
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    background: transparent;
    color: var(--ink);
    transition: border-color 200ms var(--ease-out), color 200ms var(--ease-out), transform 300ms var(--ease-out);
  }

  .icon-button:hover {
    border-color: var(--signal);
    color: var(--signal);
    transform: rotate(12deg);
  }

  .icon-sun,
  .icon-moon {
    grid-area: 1 / 1;
    transition: opacity 250ms var(--ease-out), transform 400ms var(--ease-out);
  }

  .icon-moon {
    opacity: 0;
    transform: rotate(-90deg) scale(0.6);
  }

  :global(:root[data-theme="light"]) .icon-moon {
    opacity: 1;
    transform: none;
  }

  :global(:root[data-theme="light"]) .icon-sun {
    opacity: 0;
    transform: rotate(90deg) scale(0.6);
  }

  .contact-link {
    display: none;
    min-height: 2.5rem;
    padding: 0.4rem 1rem;
    font-size: 0.875rem;
  }

  .menu-button {
    transform: none !important;
  }

  .menu-lines {
    display: grid;
    width: 1.1rem;
    gap: 0.3rem;
  }

  .menu-lines i {
    display: block;
    height: 2px;
    border-radius: 2px;
    background: currentColor;
    transition: transform 300ms var(--ease-out);
    transform-origin: center;
  }

  .menu-button[aria-expanded="true"] .menu-lines i:first-child {
    transform: translateY(0.25rem) rotate(45deg);
  }

  .menu-button[aria-expanded="true"] .menu-lines i:last-child {
    transform: translateY(-0.25rem) rotate(-45deg);
  }

  .mobile-menu {
    position: fixed;
    z-index: 40;
    inset: var(--header-h) 0 0;
    overflow-y: auto;
    background: var(--bg);
  }

  .mobile-menu-inner {
    display: grid;
    gap: 2rem;
    padding-block: 2rem 3rem;
  }

  .mobile-links {
    display: grid;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .mobile-links li {
    border-bottom: 1px solid var(--line);
    animation: rise 500ms var(--ease-out) both;
    animation-delay: calc(var(--i) * 50ms);
  }

  .mobile-links a {
    display: flex;
    align-items: baseline;
    gap: 1rem;
    padding: 1.1rem 0;
    font-size: clamp(1.6rem, 6vw, 2.2rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    text-decoration: none;
  }

  .mobile-links .mono {
    color: var(--signal);
  }

  @media (min-width: 64rem) {
    .nav-links {
      display: flex;
    }

    .contact-link {
      display: inline-flex;
    }

    .menu-button,
    .mobile-menu {
      display: none;
    }
  }

  @media (max-width: 30rem) {
    .site-name-text {
      display: none;
    }
  }
</style>
