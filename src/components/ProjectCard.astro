---
import { formatIndex } from '../lib/site';
import { useTranslations, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  name: string;
  description: string;
  url: string;
  tags: string[];
  number: number;
  year?: string;
  compact?: boolean;
}

const { lang, name, description, url, tags, number, year = '', compact = false } = Astro.props;
const t = useTranslations(lang);
---

<article class:list={['project-card', 'card', 'spot', { 'project-card--compact': compact }]}>
  <div class="project-meta">
    <span class="project-number mono" aria-hidden="true">{formatIndex(number)}</span>
    {year && <span class="project-year mono">{year}</span>}
  </div>
  <div class="project-body">
    <h3>{name}</h3>
    <p>{description}</p>
    {tags.length > 0 && (
      <ul class="project-tags" aria-label={t('projects.stack')}>
        {tags.slice(0, compact ? 3 : 5).map((tag) => (
          <li class="pill">{tag}</li>
        ))}
      </ul>
    )}
  </div>
  <div class="project-action">
    {url ? (
      <a href={url} target="_blank" rel="noopener noreferrer" class="text-link">
        {t('projects.github')}
        <span class="arrow" aria-hidden="true">↗</span>
        <span class="sr-only">{t('newTab')}</span>
      </a>
    ) : (
      <span class="mono">{t('projects.internal')}</span>
    )}
  </div>
</article>

<style>
  .project-card {
    display: grid;
    gap: 1.25rem;
    padding: clamp(1.4rem, 3vw, 2rem);
  }

  .project-meta {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    color: var(--muted);
  }

  .project-number {
    color: var(--signal);
  }

  .project-body {
    min-width: 0;
  }

  h3 {
    font-size: clamp(1.2rem, 1.1rem + 0.5vw, 1.6rem);
    line-height: 1.35;
    overflow-wrap: anywhere;
  }

  p {
    max-width: 40rem;
    margin-top: 0.7rem;
    color: var(--muted);
    line-height: 1.85;
    overflow-wrap: anywhere;
  }

  .project-card--compact p {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
    overflow: hidden;
  }

  .project-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    margin: 1.1rem 0 0;
    padding: 0;
    list-style: none;
  }

  .project-action {
    color: var(--muted);
    font-size: 0.9rem;
  }

  .project-action a {
    min-height: 2.5rem;
  }

  @media (min-width: 48rem) {
    .project-card:not(.project-card--compact) {
      grid-template-columns: 5.5rem minmax(0, 1fr) 9rem;
      align-items: start;
      gap: 1.5rem;
    }

    .project-card:not(.project-card--compact) .project-meta {
      flex-direction: column;
      gap: 0.25rem;
    }

    .project-card:not(.project-card--compact) .project-action {
      justify-self: end;
      text-align: right;
    }
  }
</style>
