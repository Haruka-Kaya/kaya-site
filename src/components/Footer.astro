---
interface Props {
  name: string;
  github: string;
  email: string;
  twitter?: string;
  hackerone?: string;
}

const { name, github, email, twitter, hackerone } = Astro.props;
---

<footer id="contact" class="footer" aria-labelledby="contact-title">
  <div class="container">
    <div class="contact-card">
      <div>
        <p class="contact-eyebrow">連絡先</p>
        <h2 id="contact-title">気軽に声をかけてください。</h2>
        <p>セキュリティの調査、作っているもの、好きなことの話ができたらうれしいです。</p>
      </div>
      <div class="contact-actions">
        {hackerone && (
          <a class="button contact-button" href={hackerone} target="_blank" rel="noopener noreferrer">
            HackerOneを見る
            <span class="sr-only">（新しいタブで開きます）</span>
          </a>
        )}
        {email && <a class="button contact-button" href={`mailto:${email}`}>メールを送る</a>}
        {github && (
          <a class="button contact-button contact-button--quiet" href={github} target="_blank" rel="noopener noreferrer">
            GitHubを見る
            <span class="sr-only">（新しいタブで開きます）</span>
          </a>
        )}
        {twitter && (
          <a class="button contact-button contact-button--quiet" href={twitter} target="_blank" rel="noopener noreferrer">
            Xを見る
            <span class="sr-only">（新しいタブで開きます）</span>
          </a>
        )}
      </div>
    </div>

    <div class="footer-bottom">
      <span>© {new Date().getFullYear()} {name}</span>
      <a href="#top">ページの上へ ↑</a>
    </div>
  </div>
</footer>

<style>
  .footer {
    padding-block: clamp(4rem, 9vw, 7rem) 2rem;
  }

  .contact-card {
    display: grid;
    gap: 2.5rem;
    padding: clamp(1.75rem, 6vw, 4rem);
    border-radius: var(--radius-2xl);
    background: var(--accent-strong);
    color: #fff;
  }

  .contact-eyebrow {
    margin: 0 0 0.7rem;
    color: #dfe9d9;
    font-size: 0.9rem;
    font-weight: 700;
  }

  h2 {
    max-width: 15ch;
    margin: 0;
    font-size: clamp(1.9rem, 1.58rem + 1.35vw, 3rem);
    line-height: 1.4;
    letter-spacing: -0.03em;
  }

  .contact-card p:last-child {
    max-width: 34rem;
    margin: 1rem 0 0;
    color: #e6eee2;
  }

  .contact-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    gap: 0.75rem;
  }

  .contact-button {
    background: #fff;
    color: var(--accent-strong);
  }

  .contact-button:hover {
    background: var(--sun);
  }

  .contact-button--quiet {
    border-color: #91a38c;
    background: transparent;
    color: #fff;
  }

  .contact-button--quiet:hover {
    border-color: #fff;
    background: #3a5736;
  }

  .footer-bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 1rem;
    padding-top: 1.5rem;
    color: var(--muted);
    font-size: 0.875rem;
  }

  .footer-bottom a {
    min-height: 2.75rem;
  }

  @media (min-width: 48rem) {
    .contact-card {
      grid-template-columns: minmax(0, 1.35fr) minmax(16rem, 0.65fr);
      align-items: end;
    }

    .contact-actions {
      justify-content: flex-end;
    }
  }
</style>
