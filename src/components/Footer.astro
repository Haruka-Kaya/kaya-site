---
import { useTranslations, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  surface?: 'portfolio' | 'tech';
  settings: {
    name: string;
    github: string;
    hackerone: string;
    email: string;
    twitter: string;
  };
}

const { lang, settings, surface = 'portfolio' } = Astro.props;
const t = useTranslations(lang);
const year = new Date().getFullYear();
---

<footer id="contact" class="footer" aria-labelledby="contact-title">
  <div class="container">
    <div class="contact-card spot" data-reveal="scale">
      <div class="contact-glow" aria-hidden="true"></div>
      <div class="contact-copy">
        <p class="eyebrow">{t('contact.eyebrow')}</p>
        <h2 id="contact-title">{t('contact.heading')}</h2>
        <p class="contact-text">{surface === 'tech' ? (lang === 'ja' ? '研究方針や技術記事についての連絡は、メールまたは各プロフィールからどうぞ。' : 'For questions about research or technical writing, reach me by email or through my profiles.') : t('contact.text')}</p>
      </div>
      <ul class="contact-actions">
        {settings.email && (
          <li>
            <a class="button button--primary" href={`mailto:${settings.email}`}>{t('contact.email')}</a>
          </li>
        )}
        {settings.hackerone && (
          <li>
            <a class="button button--secondary" href={settings.hackerone} target="_blank" rel="noopener noreferrer">
              {t('contact.hackerone')}
              <span aria-hidden="true">↗</span>
              <span class="sr-only">{t('newTab')}</span>
            </a>
          </li>
        )}
        {settings.github && (
          <li>
            <a class="button button--secondary" href={settings.github} target="_blank" rel="noopener noreferrer">
              {t('contact.github')}
              <span aria-hidden="true">↗</span>
              <span class="sr-only">{t('newTab')}</span>
            </a>
          </li>
        )}
        {settings.twitter && (
          <li>
            <a class="button button--secondary" href={settings.twitter} target="_blank" rel="noopener noreferrer">
              {t('contact.twitter')}
              <span aria-hidden="true">↗</span>
              <span class="sr-only">{t('newTab')}</span>
            </a>
          </li>
        )}
      </ul>
    </div>

    <div class="footer-bottom">
      <span>© {year} {settings.name}</span>
      <span class="footer-built">{t('footer.built')}</span>
      <a href="#top">{t('footer.top')} <span aria-hidden="true">↑</span></a>
    </div>
  </div>
</footer>

<style>
  .footer {
    padding-block: clamp(4rem, 9vw, 7rem) 1.5rem;
  }

  .contact-card {
    position: relative;
    display: grid;
    gap: 2.5rem;
    padding: clamp(2rem, 6vw, 4.5rem);
    overflow: hidden;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-2xl);
    background: var(--surface);
  }

  .contact-glow {
    position: absolute;
    z-index: 0;
    top: -40%;
    right: -20%;
    width: 60%;
    aspect-ratio: 1;
    border-radius: 50%;
    background: radial-gradient(circle, var(--glow), transparent 65%);
    animation: float 8s ease-in-out infinite;
    pointer-events: none;
  }

  h2 {
    max-width: 16ch;
    font-size: clamp(2rem, 1.5rem + 2.4vw, 3.6rem);
    line-height: 1.2;
  }

  .contact-text {
    max-width: 34rem;
    margin-top: 1.25rem;
    color: var(--muted);
  }

  .contact-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    gap: 0.75rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .footer-bottom {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-top: 1.75rem;
    color: var(--muted);
    font-size: 0.85rem;
  }

  .footer-bottom a {
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    gap: 0.35rem;
    text-decoration: none;
  }

  .footer-bottom a:hover {
    color: var(--signal);
  }

  .footer-built {
    font-family: var(--font-mono);
    font-size: 0.75rem;
  }

  @media (min-width: 48rem) {
    .contact-card {
      grid-template-columns: minmax(0, 1.3fr) minmax(16rem, 0.7fr);
      align-items: end;
    }

    .contact-actions {
      justify-content: flex-end;
    }
  }
</style>
