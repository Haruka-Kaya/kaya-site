---
import { localizePath, useTranslations, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  name: string;
  tagline: string;
  roles: string[];
  location: string;
  avatar: string;
  hackerone: string;
  github: string;
}

const { lang, name, tagline, roles, location, avatar, hackerone, github } = Astro.props;
const t = useTranslations(lang);
const headline =
  lang === 'ja'
    ? ['仕組みの境界を、', 'つくって確かめる。']
    : ['Build the system.', 'Find where it breaks.'];
---

<section class="hero" aria-labelledby="hero-title">
  <canvas class="hero-canvas" data-constellation aria-hidden="true"></canvas>
  <div class="container hero-grid">
    <div class="hero-copy">
      <p class="eyebrow hero-eyebrow" style="--i: 0">{t('hero.eyebrow')} <span class="hero-eyebrow-sep" aria-hidden="true">—</span> {t('site.tagline')}</p>
      <h1 id="hero-title">
        {headline.map((line, index) => (
          <span class="line" style={`--i: ${index + 1}`}>
            <span>{line}</span>
          </span>
        ))}
      </h1>
      <p class="hero-tagline" style="--i: 3">
        <strong class="hero-name">{name}</strong>
        <span class="display hero-tagline-text">{tagline}</span>
      </p>
      <ul class="hero-roles" style="--i: 4" aria-label={lang === 'ja' ? '肩書き' : 'Roles'}>
        {roles.map((role) => (
          <li class="pill">{role}</li>
        ))}
        {location && <li class="pill pill--location">{location}</li>}
      </ul>
      <div class="hero-actions" style="--i: 5">
        <a class="button button--primary" href={localizePath('/writeups', lang)}>{t('hero.cta.writeups')}</a>
        <a class="button button--secondary" href="#security">{t('hero.cta.security')}</a>
        {hackerone && (
          <a class="button button--ghost" href={hackerone} target="_blank" rel="noopener noreferrer">
            HackerOne
            <span aria-hidden="true">↗</span>
            <span class="sr-only">{t('newTab')}</span>
          </a>
        )}
      </div>
    </div>

    <div class="hero-visual" style="--i: 2">
      <div class="orbit" aria-hidden="true">
        <span class="orbit-ring orbit-ring--1"></span>
        <span class="orbit-ring orbit-ring--2"></span>
        <span class="orbit-dot"></span>
      </div>
      <div class="portrait">
        <img src={avatar} alt={lang === 'ja' ? `${name}のプロフィール画像` : `Portrait of ${name}`} width="420" height="420" loading="eager" fetchpriority="high" />
        <span class="portrait-fallback" aria-hidden="true">HK</span>
      </div>
      <div class="portrait-tag">
        <span class="portrait-tag-dot" aria-hidden="true"></span>
        <span class="mono">{t('security.disclosure')}</span>
      </div>
      {github && (
        <a class="portrait-link mono" href={github} target="_blank" rel="noopener noreferrer">
          github.com/Haruka-Kaya
          <span class="sr-only">{t('newTab')}</span>
        </a>
      )}
    </div>
  </div>

  <a class="scroll-cue mono" href="#about" aria-label={t('hero.scroll')}>
    <span>{t('hero.scroll')}</span>
    <span class="scroll-cue-line" aria-hidden="true"></span>
  </a>
</section>

<style>
  .hero {
    position: relative;
    min-height: calc(100svh - var(--header-h));
    display: grid;
    align-items: center;
    padding-block: clamp(3rem, 8vw, 6rem) clamp(5rem, 10vw, 7rem);
    overflow: hidden;
  }

  .hero-canvas {
    position: absolute;
    z-index: 0;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0.55;
    -webkit-mask-image: radial-gradient(ellipse at 70% 40%, #000 30%, transparent 75%);
    mask-image: radial-gradient(ellipse at 70% 40%, #000 30%, transparent 75%);
    pointer-events: none;
  }

  .hero-grid {
    position: relative;
    z-index: 1;
    display: grid;
    align-items: center;
    gap: 3.5rem;
  }

  .hero-copy > *,
  .hero-visual {
    animation: rise 900ms var(--ease-out) both;
    animation-delay: calc(var(--i, 0) * 110ms + 80ms);
  }

  .hero-eyebrow-sep {
    opacity: 0.5;
  }

  h1 {
    margin: 0;
    font-size: clamp(2.4rem, 1.6rem + 4.4vw, 5.4rem);
    line-height: 1.12;
    letter-spacing: -0.04em;
  }

  h1 .line {
    display: block;
    overflow: hidden;
  }

  h1 .line > span {
    display: block;
    animation: rise 1000ms var(--ease-out) both;
    animation-delay: calc(var(--i, 0) * 110ms + 120ms);
  }

  h1 .line:last-child > span {
    background: linear-gradient(90deg, var(--ink) 0%, var(--signal) 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .hero-tagline {
    display: grid;
    gap: 0.35rem;
    max-width: 36rem;
    margin-top: 1.75rem;
  }

  .hero-name {
    font-size: 1.05rem;
    letter-spacing: 0.02em;
  }

  .hero-tagline-text {
    color: var(--muted);
    font-size: clamp(1.3rem, 1.1rem + 0.9vw, 1.8rem);
    line-height: 1.5;
  }

  .hero-roles {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 1.5rem 0 0;
    padding: 0;
    list-style: none;
  }

  .pill--location::before {
    width: 0.45rem;
    height: 0.45rem;
    margin-right: 0.45rem;
    border-radius: 50%;
    background: var(--signal);
    content: "";
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2.25rem;
  }

  .hero-visual {
    position: relative;
    width: min(100%, 22rem);
    justify-self: center;
  }

  .orbit {
    position: absolute;
    inset: -12%;
    pointer-events: none;
  }

  .orbit-ring {
    position: absolute;
    inset: 0;
    border: 1px solid color-mix(in srgb, var(--signal) 35%, transparent);
    border-radius: 50%;
  }

  .orbit-ring--1 {
    animation: spin 40s linear infinite;
    border-style: dashed;
  }

  .orbit-ring--2 {
    inset: 6%;
    border-color: color-mix(in srgb, var(--ink) 15%, transparent);
    animation: spin 60s linear infinite reverse;
  }

  .orbit-dot {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 100%;
    height: 100%;
    transform: translate(-50%, -50%);
    animation: spin 40s linear infinite;
  }

  .orbit-dot::after {
    position: absolute;
    top: -0.35rem;
    left: 50%;
    width: 0.7rem;
    height: 0.7rem;
    border-radius: 50%;
    background: var(--signal);
    box-shadow: 0 0 0 0.4rem var(--signal-soft), 0 0 1.5rem var(--signal);
    transform: translateX(-50%);
    content: "";
  }

  @keyframes spin {
    to {
      transform: translate(-50%, -50%) rotate(360deg);
    }
  }

  .orbit-ring--1,
  .orbit-ring--2 {
    animation-name: spin-ring;
  }

  @keyframes spin-ring {
    to {
      transform: rotate(360deg);
    }
  }

  .portrait {
    position: relative;
    display: grid;
    aspect-ratio: 1;
    overflow: hidden;
    border: 1px solid var(--line-strong);
    border-radius: 50%;
    background: var(--surface-2);
    box-shadow: var(--shadow), inset 0 0 0 0.5rem var(--bg);
  }

  .portrait img,
  .portrait-fallback {
    grid-area: 1 / 1;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: saturate(0.9);
    transition: transform 700ms var(--ease-out), filter 500ms var(--ease-out);
  }

  .portrait:hover img {
    transform: scale(1.04);
    filter: saturate(1);
  }

  .portrait-fallback {
    display: grid;
    place-items: center;
    color: var(--signal);
    font-family: var(--font-mono);
    font-size: 3rem;
  }

  .portrait img {
    z-index: 1;
    background: var(--surface-2);
  }

  .portrait-tag {
    position: absolute;
    right: -0.5rem;
    bottom: 1.5rem;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.45rem 0.85rem;
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    background: var(--header-bg);
    color: var(--ink);
    backdrop-filter: blur(10px);
    animation: float 6s ease-in-out infinite;
  }

  .portrait-tag-dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--signal);
    animation: pulse 2.4s ease-out infinite;
  }

  .portrait-link {
    display: block;
    margin-top: 1.5rem;
    color: var(--muted);
    text-align: center;
    text-decoration: none;
    text-transform: none;
  }

  .portrait-link:hover {
    color: var(--signal);
  }

  .scroll-cue {
    position: absolute;
    z-index: 1;
    bottom: 1.5rem;
    left: 50%;
    display: none;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    color: var(--muted);
    text-decoration: none;
    transform: translateX(-50%);
  }

  .scroll-cue-line {
    width: 1px;
    height: 2.5rem;
    background: linear-gradient(to bottom, var(--signal), transparent);
    animation: scroll-line 2s var(--ease-in-out) infinite;
    transform-origin: top;
  }

  @keyframes scroll-line {
    0% {
      transform: scaleY(0);
      transform-origin: top;
    }
    50% {
      transform: scaleY(1);
      transform-origin: top;
    }
    51% {
      transform-origin: bottom;
    }
    100% {
      transform: scaleY(0);
      transform-origin: bottom;
    }
  }

  @media (min-width: 54rem) {
    .hero-grid {
      grid-template-columns: minmax(0, 1.4fr) minmax(18rem, 0.7fr);
      gap: clamp(3rem, 7vw, 7rem);
    }

    .hero-visual {
      width: min(100%, 24rem);
      justify-self: end;
    }

    .scroll-cue {
      display: flex;
    }
  }
</style>
