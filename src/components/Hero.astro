---
interface Props {
  name: string;
  tagline: string;
  avatar: string;
  hackerone?: string;
}

const { name, tagline, avatar, hackerone } = Astro.props;
---

<section class="hero" aria-labelledby="hero-title">
  <div class="container hero-grid">
    <div class="hero-copy">
      <p class="eyebrow hero-eyebrow"><span aria-hidden="true"></span> Security researcher & maker</p>
      <h1 id="hero-title">
        仕組みの<span class="highlight">境界</span>を、<br />
        つくって<br class="mobile-break" />確かめる。
      </h1>
      <p class="hero-tagline"><strong>{name}。</strong>{tagline}</p>
      <p class="hero-note">
        HackerOneで脆弱性を調べながら、Linuxや電子工作、<br class="desktop-break" />
        AIを使ったものづくりを楽しんでいます。
      </p>
      <div class="hero-actions">
        <a class="button button--primary" href="#security">調査について</a>
        {hackerone && (
          <a class="button button--secondary" href={hackerone} target="_blank" rel="noopener noreferrer">
            HackerOne
            <span aria-hidden="true">↗</span>
            <span class="sr-only">（新しいタブで開きます）</span>
          </a>
        )}
        <a class="button button--secondary" href="#projects">作ったものを見る</a>
      </div>
    </div>

    <div class="profile-visual">
      <div class="profile-backdrop" aria-hidden="true"></div>
      <div class="profile-frame">
        {avatar ? (
          <img src={avatar} alt={`${name}のプロフィール画像`} width="420" height="420" loading="eager" fetchpriority="high" />
        ) : (
          <span class="profile-initial" aria-hidden="true">H</span>
        )}
      </div>
      <div class="profile-caption">
        <span>{name}</span>
        <span class="profile-role"><i aria-hidden="true"></i> Responsible disclosure</span>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    padding-block: clamp(4.5rem, 10vw, 8rem);
  }

  .hero::before {
    position: absolute;
    z-index: -1;
    inset: 0;
    background-image: linear-gradient(color-mix(in srgb, var(--accent) 7%, transparent) 1px, transparent 1px),
      linear-gradient(90deg, color-mix(in srgb, var(--accent) 7%, transparent) 1px, transparent 1px);
    background-size: 3rem 3rem;
    -webkit-mask-image: linear-gradient(to bottom, #000, transparent 82%);
    mask-image: linear-gradient(to bottom, #000, transparent 82%);
    content: "";
    pointer-events: none;
  }

  .hero-grid {
    display: grid;
    align-items: center;
    gap: 4rem;
  }

  .hero-copy {
    min-width: 0;
  }

  .hero-eyebrow {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    text-transform: uppercase;
  }

  .hero-eyebrow span {
    width: 0.55rem;
    height: 0.55rem;
    border-radius: 50%;
    background: var(--accent);
  }

  h1 {
    max-width: 13ch;
    margin: 0;
    font-size: clamp(2.2rem, 1.82rem + 1.8vw, 4.4rem);
    font-weight: 700;
    line-height: 1.28;
    letter-spacing: -0.045em;
  }

  h1 .highlight {
    position: relative;
    z-index: 0;
    white-space: nowrap;
  }

  h1 .highlight::after {
    position: absolute;
    z-index: -1;
    right: -0.06em;
    bottom: 0.08em;
    left: -0.06em;
    height: 0.28em;
    border-radius: 999px;
    background: var(--sun);
    content: "";
  }

  .hero-tagline {
    max-width: 29rem;
    margin: 1.75rem 0 0;
    font-size: clamp(1.15rem, 1.05rem + 0.35vw, 1.4rem);
    font-weight: 700;
    line-height: 1.65;
  }

  .hero-tagline strong {
    color: var(--accent-strong);
  }

  .hero-note {
    max-width: 34rem;
    margin: 0.9rem 0 0;
    color: var(--muted);
  }

  .desktop-break {
    display: none;
  }

  @media (min-width: 30rem) {
    .mobile-break {
      display: none;
    }
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2rem;
  }

  .profile-visual {
    position: relative;
    width: min(100%, 23rem);
    justify-self: center;
    padding: 1rem 1rem 0;
  }

  .profile-backdrop {
    position: absolute;
    top: -1rem;
    right: -0.75rem;
    width: 52%;
    height: 48%;
    border-radius: 50%;
    background: var(--peach);
  }

  .profile-frame {
    position: relative;
    aspect-ratio: 1;
    overflow: hidden;
    border: 1px solid var(--ink);
    border-radius: var(--radius-2xl);
    background: var(--paper);
  }

  .profile-frame img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .profile-initial {
    display: grid;
    width: 100%;
    height: 100%;
    place-items: center;
    background: var(--sun);
    font-size: 7rem;
    font-weight: 700;
  }

  .profile-caption {
    position: relative;
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.85rem 0.25rem 0;
    color: var(--muted);
    font-size: 0.875rem;
  }

  .profile-role {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
  }

  .profile-role i {
    width: 0.45rem;
    height: 0.45rem;
    border-radius: 50%;
    background: var(--accent);
  }

  @media (min-width: 46rem) {
    .hero-grid {
      grid-template-columns: minmax(0, 1.35fr) minmax(16rem, 0.65fr);
      gap: clamp(3rem, 7vw, 7rem);
    }

    .desktop-break {
      display: block;
    }
  }
</style>
