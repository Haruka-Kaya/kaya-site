---
import { localizePath, useTranslations, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  name: string;
  altName: string;
  tagline: string;
  roles: string[];
  location: string;
  focus: string[];
  hackerone: string;
  github: string;
  twitter: string;
}

const { lang, name, altName, tagline, roles, location, focus, hackerone, github, twitter } = Astro.props;
const t = useTranslations(lang);
const headline =
  lang === 'ja'
    ? ['気になったら、', 'つくってみる。']
    : ['Get curious.', 'Make something.'];

const links = [
  { label: 'HackerOne', href: hackerone },
  { label: 'GitHub', href: github },
  { label: 'X', href: twitter },
].filter((link) => link.href);
---

<section class="hero" aria-labelledby="hero-title">
  <canvas class="hero-canvas" data-constellation aria-hidden="true"></canvas>
  <div class="container hero-grid">
    <div class="hero-copy">
      <p class="eyebrow hero-eyebrow" style="--i: 0">{t('hero.eyebrow')} <span class="hero-eyebrow-sep" aria-hidden="true">—</span> {t('site.tagline')}</p>
      <h1 id="hero-title">
        {headline.map((line, index) => (
          <span class="line" style={`--i: ${index + 1}`}>
            <span>{line}</span>
          </span>
        ))}
      </h1>
      <p class="hero-tagline" style="--i: 3">
        <strong class="hero-name">{name}</strong>
        <span class="display hero-tagline-text">{tagline}</span>
      </p>
      <ul class="hero-roles" style="--i: 4" aria-label={lang === 'ja' ? '肩書き' : 'Roles'}>
        {roles.map((role) => (
          <li class="pill">{role}</li>
        ))}
        {location && <li class="pill pill--location">{location}</li>}
      </ul>
      <div class="hero-actions" style="--i: 5">
        <a class="button button--primary" href={localizePath('/writeups', lang)}>{t('hero.cta.writeups')}</a>
        <a class="button button--secondary" href="#interests">{t('nav.interests')}</a>
        {hackerone && (
          <a class="button button--ghost" href={hackerone} target="_blank" rel="noopener noreferrer">
            HackerOne
            <span aria-hidden="true">↗</span>
            <span class="sr-only">{t('newTab')}</span>
          </a>
        )}
      </div>
    </div>

    <div class="hero-visual" style="--i: 2">
      <div class="orbit" aria-hidden="true">
        <span class="orbit-ring orbit-ring--1"></span>
        <span class="orbit-ring orbit-ring--2"></span>
        <span class="orbit-dot"></span>
      </div>
      <div class="id-card spot" aria-label={lang === 'ja' ? 'プロフィールカード' : 'Profile card'}>
        <div class="id-card-head">
          <span class="id-status mono">
            <span class="id-status-dot" aria-hidden="true"></span>
            {lang === 'ja' ? 'つくる・飛ばす・遊ぶ' : 'Make / Fly / Explore'}
          </span>
          <span class="id-mark mono" aria-hidden="true">HK</span>
        </div>
        <p class="id-name">{name}</p>
        <p class="id-alt display">{altName}</p>
        <dl class="id-rows">
          {location && (
            <div class="id-row">
              <dt class="mono">{t('about.location')}</dt>
              <dd>{location}</dd>
            </div>
          )}
          {focus.length > 0 && (
            <div class="id-row">
              <dt class="mono">{t('nav.interests')}</dt>
              <dd>{focus.join(' / ')}</dd>
            </div>
          )}
          {links.length > 0 && (
            <div class="id-row">
              <dt class="mono">Links</dt>
              <dd class="id-links">
                {links.map((link) => (
                  <a href={link.href} target="_blank" rel="noopener noreferrer">
                    {link.label}
                    <span aria-hidden="true">↗</span>
                    <span class="sr-only">{t('newTab')}</span>
                  </a>
                ))}
              </dd>
            </div>
          )}
        </dl>
        <div class="id-strip" aria-hidden="true">
          <span></span><span></span><span></span><span></span><span></span><span></span>
        </div>
      </div>
    </div>
  </div>

  <a class="scroll-cue mono" href="#about" aria-label={t('hero.scroll')}>
    <span>{t('hero.scroll')}</span>
    <span class="scroll-cue-line" aria-hidden="true"></span>
  </a>
</section>

<style>
  .hero {
    position: relative;
    min-height: calc(100svh - var(--header-h));
    display: grid;
    align-items: center;
    padding-block: clamp(3rem, 8vw, 6rem) clamp(5rem, 10vw, 7rem);
    overflow: hidden;
  }

  .hero-canvas {
    position: absolute;
    z-index: 0;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0.55;
    -webkit-mask-image: radial-gradient(ellipse at 70% 40%, #000 30%, transparent 75%);
    mask-image: radial-gradient(ellipse at 70% 40%, #000 30%, transparent 75%);
    pointer-events: none;
  }

  .hero-grid {
    position: relative;
    z-index: 1;
    display: grid;
    align-items: center;
    gap: 3.5rem;
  }

  .hero-copy > *,
  .hero-visual {
    animation: rise 900ms var(--ease-out) both;
    animation-delay: calc(var(--i, 0) * 110ms + 80ms);
  }

  .hero-eyebrow-sep {
    opacity: 0.5;
  }

  h1 {
    margin: 0;
    font-size: clamp(2.4rem, 1.5rem + 3.8vw, 4.6rem);
    line-height: 1.12;
    letter-spacing: -0.04em;
  }

  h1 .line {
    display: block;
    overflow: hidden;
  }

  h1 .line > span {
    display: block;
    animation: rise 1000ms var(--ease-out) both;
    animation-delay: calc(var(--i, 0) * 110ms + 120ms);
  }

  h1 .line:last-child > span {
    background: linear-gradient(90deg, var(--ink) 0%, var(--signal) 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .hero-tagline {
    display: grid;
    gap: 0.35rem;
    max-width: 36rem;
    margin-top: 1.75rem;
  }

  .hero-name {
    font-size: 1.05rem;
    letter-spacing: 0.02em;
  }

  .hero-tagline-text {
    color: var(--muted);
    font-size: clamp(1.3rem, 1.1rem + 0.9vw, 1.8rem);
    line-height: 1.5;
  }

  .hero-roles {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 1.5rem 0 0;
    padding: 0;
    list-style: none;
  }

  .pill--location::before {
    width: 0.45rem;
    height: 0.45rem;
    margin-right: 0.45rem;
    border-radius: 50%;
    background: var(--signal);
    content: "";
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2.25rem;
  }

  .hero-visual {
    position: relative;
    width: min(100%, 24rem);
    justify-self: center;
    padding: 1.5rem;
  }

  .orbit {
    position: absolute;
    inset: -8% -14%;
    pointer-events: none;
  }

  .orbit-ring {
    position: absolute;
    inset: 0;
    border: 1px solid color-mix(in srgb, var(--signal) 35%, transparent);
    border-radius: 50%;
    animation: spin-ring 40s linear infinite;
  }

  .orbit-ring--1 {
    border-style: dashed;
  }

  .orbit-ring--2 {
    inset: 6%;
    border-color: color-mix(in srgb, var(--ink) 15%, transparent);
    animation-duration: 60s;
    animation-direction: reverse;
  }

  .orbit-dot {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 100%;
    height: 100%;
    transform: translate(-50%, -50%);
    animation: spin 40s linear infinite;
  }

  .orbit-dot::after {
    position: absolute;
    top: -0.35rem;
    left: 50%;
    width: 0.7rem;
    height: 0.7rem;
    border-radius: 50%;
    background: var(--signal);
    box-shadow: 0 0 0 0.4rem var(--signal-soft), 0 0 1.5rem var(--signal);
    transform: translateX(-50%);
    content: "";
  }

  @keyframes spin {
    to {
      transform: translate(-50%, -50%) rotate(360deg);
    }
  }

  @keyframes spin-ring {
    to {
      transform: rotate(360deg);
    }
  }

  .id-card {
    position: relative;
    overflow: hidden;
    padding: 1.5rem;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-xl);
    background: color-mix(in srgb, var(--surface) 82%, transparent);
    box-shadow: var(--shadow);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    transform: rotate(-1.5deg);
    transition: transform 600ms var(--ease-out), border-color 300ms var(--ease-out);
  }

  .id-card:hover {
    border-color: color-mix(in srgb, var(--signal) 45%, var(--line-strong));
    transform: rotate(0deg) translateY(-4px);
  }

  .id-card > * {
    position: relative;
    z-index: 1;
  }

  .id-card-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--line);
  }

  .id-status {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--muted);
  }

  .id-status-dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--signal);
    animation: pulse 2.4s ease-out infinite;
  }

  .id-mark {
    display: grid;
    width: 2.25rem;
    height: 2rem;
    place-items: center;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-sm);
    color: var(--signal);
  }

  .id-name {
    margin-top: 1.25rem;
    font-size: clamp(1.8rem, 1.5rem + 1.2vw, 2.4rem);
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: -0.03em;
  }

  .id-alt {
    margin-top: 0.15rem;
    color: var(--muted);
    font-size: 1.25rem;
  }

  .id-rows {
    display: grid;
    gap: 0.85rem;
    margin: 1.5rem 0 0;
  }

  .id-row {
    display: grid;
    gap: 0.2rem;
  }

  .id-row dt {
    color: var(--signal);
  }

  .id-row dd {
    margin: 0;
    font-size: 0.95rem;
    line-height: 1.6;
  }

  .id-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 1rem;
  }

  .id-links a {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    color: var(--ink);
    font-weight: 700;
    text-decoration: none;
  }

  .id-links a:hover {
    color: var(--signal);
  }

  .id-strip {
    display: flex;
    gap: 0.3rem;
    margin-top: 1.5rem;
  }

  .id-strip span {
    height: 0.35rem;
    flex: 1;
    border-radius: 999px;
    background: var(--line);
  }

  .id-strip span:nth-child(-n + 2) {
    background: var(--signal);
  }

  .scroll-cue {
    position: absolute;
    z-index: 1;
    bottom: 1.5rem;
    left: 50%;
    display: none;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    color: var(--muted);
    text-decoration: none;
    transform: translateX(-50%);
  }

  .scroll-cue-line {
    width: 1px;
    height: 2.5rem;
    background: linear-gradient(to bottom, var(--signal), transparent);
    animation: scroll-line 2s var(--ease-in-out) infinite;
    transform-origin: top;
  }

  @keyframes scroll-line {
    0% {
      transform: scaleY(0);
      transform-origin: top;
    }
    50% {
      transform: scaleY(1);
      transform-origin: top;
    }
    51% {
      transform-origin: bottom;
    }
    100% {
      transform: scaleY(0);
      transform-origin: bottom;
    }
  }

  @media (min-width: 54rem) {
    .hero-grid {
      grid-template-columns: minmax(0, 1.4fr) minmax(19rem, 0.7fr);
      gap: clamp(3rem, 7vw, 7rem);
    }

    .hero-visual {
      width: min(100%, 26rem);
      justify-self: end;
    }

    .scroll-cue {
      display: flex;
    }
  }
</style>
