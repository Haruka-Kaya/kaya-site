---
import { formatIndex } from '../lib/site';

interface Props {
  name: string;
  description: string;
  icon: string;
  slug: string;
  index: number;
}

const { name, description, icon, slug, index } = Astro.props;
---

<article class="like-card">
  <div class="like-card-top">
    <span class="like-icon" aria-hidden="true">{icon}</span>
    <span class="like-number" aria-hidden="true">{formatIndex(index)}</span>
  </div>
  <h3>{name}</h3>
  <p>{description}</p>
  <a href={`/hobbies/${slug}`} class="text-link">
    もう少し詳しく
  </a>
</article>

<style>
  .like-card {
    display: flex;
    min-width: 0;
    height: 100%;
    flex-direction: column;
    padding: clamp(1.35rem, 3vw, 1.8rem);
    border: 1px solid var(--line);
    border-radius: var(--radius-xl);
    background: var(--paper);
  }

  .like-card-top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1.35rem;
  }

  .like-icon {
    display: grid;
    width: 3.25rem;
    height: 3.25rem;
    place-items: center;
    border-radius: var(--radius-lg);
    background: var(--accent-soft);
    font-size: 1.45rem;
  }

  .like-number {
    color: var(--muted);
    font-size: 0.875rem;
    font-variant-numeric: tabular-nums;
  }

  h3 {
    margin: 0;
    font-size: 1.2rem;
    line-height: 1.5;
  }

  p {
    flex: 1;
    margin: 0.8rem 0 1.25rem;
    color: var(--muted);
    font-size: 0.95rem;
    line-height: 1.8;
    overflow-wrap: anywhere;
  }

  a {
    align-self: flex-start;
    min-height: 2.75rem;
    align-items: center;
    gap: 0.4rem;
  }

  .text-link {
    display: inline-flex;
  }

  .text-link::after {
    content: "→";
  }
</style>
