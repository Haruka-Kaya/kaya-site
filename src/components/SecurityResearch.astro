---
interface Props {
  hackerone: string;
}

const { hackerone } = Astro.props;

const focusAreas = [
  {
    number: '01',
    name: 'Android',
    detail: 'IPC・exported components・permission boundaries',
  },
  {
    number: '02',
    name: 'Web & API',
    detail: 'authentication・tokens・access control',
  },
  {
    number: '03',
    name: 'AI Agents',
    detail: 'prompt injection・tool authorization',
  },
];

const researchSteps = [
  { label: 'Scope', text: 'ルールと対象範囲を読む' },
  { label: 'Reproduce', text: '前提を減らして再現する' },
  { label: 'Report', text: '証拠と影響を分けて伝える' },
];
---

<section id="security" class="security" aria-labelledby="security-title">
  <div class="container security-grid">
    <div class="security-copy">
      <p class="security-eyebrow"><span aria-hidden="true"></span> Security research</p>
      <h2 id="security-title">境界を見つけ、<br />再現して確かめる。</h2>
      <p class="security-lead">
        アプリやAPIを眺めて終わらず、どの権限から、どの入力で、どこまで影響が届くのかを追います。
        許可された範囲で再現し、確認できた事実と前提を分けて報告することを大切にしています。
      </p>

      <ol class="research-steps" aria-label="調査で大切にしていること">
        {researchSteps.map((step, index) => (
          <li>
            <span class="step-number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
            <span><strong>{step.label}</strong>{step.text}</span>
          </li>
        ))}
      </ol>

      {hackerone && (
        <a class="security-link" href={hackerone} target="_blank" rel="noopener noreferrer">
          HackerOneのプロフィールを見る
          <span aria-hidden="true">↗</span>
          <span class="sr-only">（新しいタブで開きます）</span>
        </a>
      )}
    </div>

    <section class="research-board" aria-labelledby="focus-title">
      <div class="board-header">
        <h3 id="focus-title">Current focus</h3>
        <span>03 areas</span>
      </div>
      <ul class="focus-list">
        {focusAreas.map((area) => (
          <li>
            <span class="focus-number" aria-hidden="true">{area.number}</span>
            <span class="focus-copy">
              <strong>{area.name}</strong>
              <span>{area.detail}</span>
            </span>
          </li>
        ))}
      </ul>
      <p class="disclosure-note">
        <span aria-hidden="true"></span>
        Responsible disclosure
      </p>
    </section>
  </div>
</section>

<style>
  .security {
    --ring: var(--signal);
    padding-block: clamp(4.5rem, 9vw, 7.5rem);
    background: var(--security);
    color: var(--security-ink);
  }

  .security-grid {
    display: grid;
    gap: clamp(3rem, 7vw, 6rem);
  }

  .security-copy {
    min-width: 0;
  }

  .security-eyebrow {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin: 0 0 1rem;
    color: var(--signal);
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 0.875rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .security-eyebrow span,
  .disclosure-note span {
    width: 0.55rem;
    height: 0.55rem;
    flex: 0 0 auto;
    border-radius: 50%;
    background: var(--signal);
  }

  h2 {
    max-width: 16ch;
    margin: 0;
    font-size: clamp(2rem, 1.6rem + 1.7vw, 3.5rem);
    line-height: 1.38;
    letter-spacing: -0.035em;
  }

  .security-lead {
    max-width: 42rem;
    margin: 1.5rem 0 0;
    color: var(--security-muted);
    font-size: clamp(1rem, 0.96rem + 0.2vw, 1.125rem);
    line-height: 1.9;
  }

  .research-steps {
    display: grid;
    gap: 0;
    margin: 2rem 0 0;
    padding: 0;
    border-block: 1px solid var(--security-line);
    list-style: none;
  }

  .research-steps li {
    display: grid;
    grid-template-columns: 2.5rem minmax(0, 1fr);
    gap: 0.75rem;
    padding-block: 0.85rem;
    border-bottom: 1px solid var(--security-line);
  }

  .research-steps li:last-child {
    border-bottom: 0;
  }

  .step-number {
    color: var(--signal);
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 0.875rem;
  }

  .research-steps strong {
    display: inline-block;
    min-width: 6.5rem;
    margin-right: 0.75rem;
    color: var(--security-ink);
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 0.875rem;
    text-transform: uppercase;
  }

  .security-link {
    display: inline-flex;
    min-height: 3rem;
    align-items: center;
    gap: 0.55rem;
    margin-top: 2rem;
    color: var(--signal);
    font-weight: 700;
  }

  .research-board {
    align-self: center;
    min-width: 0;
    padding: clamp(1.25rem, 3vw, 1.75rem);
    border: 1px solid var(--security-line);
    border-radius: var(--radius-xl);
    background: var(--security-panel);
    box-shadow: 0.75rem 0.75rem 0 color-mix(in srgb, var(--signal) 16%, transparent);
  }

  .board-header {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--security-line);
    color: var(--security-muted);
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 0.875rem;
    text-transform: uppercase;
  }

  .board-header h3 {
    margin: 0;
    font: inherit;
  }

  .focus-list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .focus-list li {
    display: grid;
    grid-template-columns: 2.25rem minmax(0, 1fr);
    gap: 0.8rem;
    padding-block: 1.35rem;
    border-bottom: 1px solid var(--security-line);
  }

  .focus-number {
    color: var(--signal);
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 0.875rem;
  }

  .focus-copy {
    display: grid;
    min-width: 0;
    gap: 0.3rem;
  }

  .focus-copy strong {
    font-size: 1.1rem;
  }

  .focus-copy span {
    color: var(--security-muted);
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 0.875rem;
    line-height: 1.65;
    overflow-wrap: anywhere;
  }

  .disclosure-note {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    margin: 1.25rem 0 0;
    color: var(--security-muted);
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 0.875rem;
  }

  @media (min-width: 54rem) {
    .security-grid {
      grid-template-columns: minmax(0, 1.15fr) minmax(20rem, 0.85fr);
      align-items: start;
    }
  }

  @media (max-width: 30rem) {
    .research-steps strong {
      display: block;
      min-width: 0;
      margin: 0 0 0.2rem;
    }

    .research-board {
      box-shadow: 0.45rem 0.45rem 0 color-mix(in srgb, var(--signal) 16%, transparent);
    }
  }
</style>
