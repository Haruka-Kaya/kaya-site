---
import { formatIndex } from '../lib/site';
import { useTranslations, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  lead: string;
  focus: Array<{ name: string; detail: string }>;
  steps: Array<{ label: string; text: string }>;
  hackerone: string;
}

const { lang, lead, focus, steps, hackerone } = Astro.props;
const t = useTranslations(lang);
---

<section id="security" class="section security" aria-labelledby="security-title">
  <div class="security-bg" aria-hidden="true"></div>
  <div class="container security-grid">
    <div class="security-copy">
      <div data-reveal>
        <p class="eyebrow">{t('security.eyebrow')}</p>
        <h2 id="security-title" class="section-heading">{t('security.heading')}</h2>
        <p class="security-lead">{lead}</p>
      </div>

      <ol class="research-steps" aria-label={t('security.process')}>
        {steps.map((step, index) => (
          <li data-reveal style={`--reveal-delay: ${index * 90}ms`}>
            <span class="step-number mono" aria-hidden="true">{formatIndex(index + 1)}</span>
            <span class="step-body">
              <strong class="mono">{step.label}</strong>
              <span>{step.text}</span>
            </span>
          </li>
        ))}
      </ol>

      {hackerone && (
        <a class="text-link security-link" href={hackerone} target="_blank" rel="noopener noreferrer" data-reveal>
          {t('security.hackerone')}
          <span class="arrow" aria-hidden="true">↗</span>
          <span class="sr-only">{t('newTab')}</span>
        </a>
      )}
    </div>

    <div class="research-board card spot" data-reveal="scale" style="--reveal-delay: 150ms" aria-labelledby="focus-title">
      <div class="board-header mono">
        <h3 id="focus-title">{t('security.focus')}</h3>
        <span>{formatIndex(focus.length)} {t('security.areas')}</span>
      </div>
      <ul class="focus-list">
        {focus.map((area, index) => (
          <li>
            <span class="focus-number mono" aria-hidden="true">{formatIndex(index + 1)}</span>
            <span class="focus-copy">
              <strong>{area.name}</strong>
              <span>{area.detail}</span>
            </span>
            <span class="focus-bar" aria-hidden="true"></span>
          </li>
        ))}
      </ul>
      <p class="disclosure-note mono">
        <span class="disclosure-dot" aria-hidden="true"></span>
        {t('security.disclosure')}
      </p>
    </div>
  </div>
</section>

<style>
  .security {
    overflow: hidden;
  }

  .security-bg {
    position: absolute;
    z-index: -1;
    inset: 0;
    background:
      radial-gradient(50rem 30rem at 100% 50%, var(--glow), transparent 60%),
      linear-gradient(to bottom, transparent, color-mix(in srgb, var(--surface) 60%, transparent), transparent);
  }

  .security-grid {
    display: grid;
    gap: clamp(3rem, 7vw, 6rem);
  }

  .security-lead {
    max-width: 40rem;
    margin-top: 1.5rem;
    color: var(--muted);
    font-size: clamp(1rem, 0.96rem + 0.2vw, 1.125rem);
    line-height: 1.9;
  }

  .research-steps {
    display: grid;
    margin: 2.5rem 0 0;
    padding: 0;
    border-top: 1px solid var(--line);
    list-style: none;
  }

  .research-steps li {
    display: grid;
    grid-template-columns: 2.75rem minmax(0, 1fr);
    gap: 0.75rem;
    padding-block: 1rem;
    border-bottom: 1px solid var(--line);
    transition: padding-left 300ms var(--ease-out);
  }

  .research-steps li:hover {
    padding-left: 0.5rem;
  }

  .step-number {
    color: var(--signal);
  }

  .step-body {
    display: grid;
    gap: 0.2rem;
  }

  .step-body strong {
    color: var(--ink);
  }

  .step-body span {
    color: var(--muted);
  }

  .security-link {
    margin-top: 2rem;
    font-size: 1rem;
  }

  .research-board {
    align-self: center;
    padding: clamp(1.25rem, 3vw, 1.75rem);
    border-color: color-mix(in srgb, var(--signal) 30%, var(--line));
  }

  .board-header {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--line);
    color: var(--muted);
  }

  .board-header h3 {
    margin: 0;
    font: inherit;
    letter-spacing: inherit;
    text-transform: inherit;
  }

  .focus-list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .focus-list li {
    position: relative;
    display: grid;
    grid-template-columns: 2.25rem minmax(0, 1fr);
    gap: 0.8rem;
    padding-block: 1.35rem;
    border-bottom: 1px solid var(--line);
  }

  .focus-number {
    color: var(--signal);
  }

  .focus-copy {
    display: grid;
    min-width: 0;
    gap: 0.3rem;
  }

  .focus-copy strong {
    font-size: 1.15rem;
  }

  .focus-copy span {
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 0.8rem;
    line-height: 1.65;
    overflow-wrap: anywhere;
  }

  .focus-bar {
    position: absolute;
    bottom: -1px;
    left: 0;
    width: 0;
    height: 1px;
    background: var(--signal);
    transition: width 600ms var(--ease-out);
  }

  .focus-list li:hover .focus-bar {
    width: 100%;
  }

  .disclosure-note {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    margin: 1.25rem 0 0;
    color: var(--muted);
  }

  .disclosure-dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--signal);
    animation: pulse 2.4s ease-out infinite;
  }

  @media (min-width: 56rem) {
    .security-grid {
      grid-template-columns: minmax(0, 1.15fr) minmax(20rem, 0.85fr);
      align-items: start;
    }
  }
</style>
