---
interface Props {
  bio: string;
  location: string;
}

const { bio, location } = Astro.props;
---

<section id="about" class="about" aria-labelledby="about-title">
  <div class="container about-grid">
    <div>
      <p class="eyebrow">わたしのこと</p>
      <h2 id="about-title" class="section-heading">まずは、触って確かめたい。</h2>
    </div>

    <div class="about-copy">
      <p>{bio}</p>
      {location && (
        <p class="location">
          {location} にいます
        </p>
      )}
    </div>
  </div>
</section>

<style>
  .about {
    padding-block: clamp(4.5rem, 9vw, 7.5rem);
    border-block: 1px solid var(--line);
    background: var(--paper);
  }

  .about-grid {
    display: grid;
    gap: 2.5rem;
  }

  .about-copy {
    max-width: 42rem;
  }

  .about-copy > p:first-child {
    margin: 0;
    white-space: pre-line;
    font-size: clamp(1.05rem, 1rem + 0.25vw, 1.2rem);
    line-height: 2;
  }

  .location {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    margin: 1.75rem 0 0;
    padding: 0.45rem 0.75rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    color: var(--muted);
    font-size: 0.9rem;
  }

  .location::before {
    width: 0.45rem;
    height: 0.45rem;
    border-radius: 50%;
    background: var(--accent);
    content: "";
  }

  @media (min-width: 48rem) {
    .about-grid {
      grid-template-columns: minmax(14rem, 0.7fr) minmax(0, 1.3fr);
      gap: clamp(3rem, 8vw, 8rem);
    }
  }
</style>
