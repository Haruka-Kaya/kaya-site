---
import BaseLayout from '../layouts/BaseLayout.astro';
import WriteupCard from '../components/WriteupCard.astro';
import { loadSiteContext, loadWriteups } from '../lib/site';
import { localizePath, useTranslations, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  technical?: boolean;
}

const { lang, technical = false } = Astro.props;
const t = useTranslations(lang);
const [{ settings }, writeups] = await Promise.all([loadSiteContext(lang), loadWriteups(lang, { surface: technical ? 'tech' : 'portfolio' })]);
const pageTitle = `${technical ? 'Technical Writeups' : 'Notes'} | ${settings.name}`;
const path = technical ? '/tech/writeups' : '/writeups';
const intro = technical ? (lang === 'ja' ? 'セキュリティ、権限設計、実装と検証。前提と確認できた範囲を明記した技術記録。' : 'Security, authorization, implementation, and verification. Technical records with explicit assumptions and evidence.') : t('writeups.intro');
const categories = Array.from(new Set(writeups.map((post) => post.data.category)));
---

<BaseLayout lang={lang} title={pageTitle} description={intro} path={path} settings={settings} surface={technical ? 'tech' : 'portfolio'}>
  <main id="main-content" class="list-page">
    <div class="container">
      <a href={localizePath(technical ? '/tech' : '/', lang)} class="text-link back-link">
        <span class="arrow arrow--back" aria-hidden="true">←</span>
        {t('nav.home')}
      </a>
      <header class="page-header">
        <p class="eyebrow">{technical ? 'Technical archive' : t('writeups.eyebrow')}</p>
        <h1 class="section-heading">{technical ? (lang === 'ja' ? '技術記事' : 'Technical writing') : t('writeups.heading')}</h1>
        <p class="section-intro">{intro}</p>
        <a class="text-link" href={localizePath(technical ? '/writeups' : '/tech/writeups', lang)}>{technical ? (lang === 'ja' ? '制作こぼれ話はこちら →' : 'Build outtakes →') : (lang === 'ja' ? '技術記事を探している方はこちら →' : 'Looking for technical articles? →')}</a>
        <p class="meta-row mono">
          <span class="count">{t('writeups.count', { n: writeups.length })}</span>
          {categories.map((category) => (
            <span class="pill">{category}</span>
          ))}
        </p>
      </header>

      {writeups.length > 0 ? (
        <div class="writeup-grid">
          {writeups.map((post, index) => (
            <div data-reveal style={`--reveal-delay: ${(index % 2) * 90}ms`}>
              <WriteupCard
                lang={lang}
                slug={post.slug}
                title={post.data.title}
                summary={post.data.summary}
                date={post.data.date}
                category={post.data.category}
                tags={post.data.tags}
                readingMinutes={post.readingMinutes}
              />
            </div>
          ))}
        </div>
      ) : (
        <p class="section-intro">{t('writeups.empty')}</p>
      )}
    </div>
  </main>
</BaseLayout>

<style>
  .list-page {
    padding-block: clamp(2.5rem, 6vw, 5rem) clamp(3rem, 8vw, 6rem);
  }

  .back-link {
    min-height: 2.75rem;
  }

  .arrow--back {
    transition: transform 250ms var(--ease-out);
  }

  .back-link:hover .arrow--back {
    transform: translateX(-0.25rem);
  }

  .page-header {
    margin: 2rem 0 3rem;
    animation: rise 700ms var(--ease-out) both;
  }

  .meta-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    margin-top: 1.25rem;
  }

  .count {
    margin-right: 0.5rem;
    color: var(--signal);
  }

  .writeup-grid {
    display: grid;
    gap: 1rem;
  }

  .writeup-grid > * {
    min-width: 0;
  }

  @media (min-width: 48rem) {
    .writeup-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
