---
import BaseLayout from '../layouts/BaseLayout.astro';
import { loadHobby, loadSiteContext } from '../lib/site';
import { localizePath, useTranslations, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  slug: string;
}

const { lang, slug } = Astro.props;
const t = useTranslations(lang);
const [{ settings }, hobby] = await Promise.all([loadSiteContext(lang), loadHobby(slug, lang)]);

const paragraphs = hobby.detail.split(/\n\s*\n/).filter(Boolean);
const pageTitle = `${hobby.name} | ${settings.name}`;
const home = localizePath('/', lang);
---

<BaseLayout lang={lang} title={pageTitle} description={hobby.description} path={`/hobbies/${slug}`} ogType="article" settings={settings}>
  <main id="main-content" class="hobby-page">
    <article class="container hobby-article">
      <a href={`${home}#interests`} class="back-link text-link">
        <span class="arrow arrow--back" aria-hidden="true">←</span>
        {t('interests.back')}
      </a>

      <header class="hobby-header">
        <span class="hobby-icon" aria-hidden="true">{hobby.icon}</span>
        <div>
          <p class="eyebrow">{t('interests.eyebrow')}</p>
          <h1>{hobby.name}</h1>
        </div>
      </header>

      <p class="hobby-lead display">{hobby.description}</p>

      {paragraphs.length > 0 && (
        <div class="hobby-detail">
          {paragraphs.map((paragraph, index) => (
            <p data-reveal style={`--reveal-delay: ${index * 60}ms`}>{paragraph}</p>
          ))}
        </div>
      )}

      <aside class="hobby-aside card spot" data-reveal>
        <p>{t('interests.others')}</p>
        <a class="button button--secondary" href={`${home}#interests`}>{t('interests.list')}</a>
      </aside>
    </article>
  </main>
</BaseLayout>

<style>
  .hobby-page {
    padding-block: clamp(2.5rem, 6vw, 5rem) clamp(3rem, 8vw, 6rem);
  }

  .hobby-article {
    max-width: 50rem;
  }

  .back-link {
    min-height: 2.75rem;
  }

  .arrow--back {
    transition: transform 250ms var(--ease-out);
  }

  .back-link:hover .arrow--back {
    transform: translateX(-0.25rem);
  }

  .hobby-header {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    margin-top: 2.5rem;
    animation: rise 700ms var(--ease-out) both;
  }

  .hobby-icon {
    display: grid;
    width: 4.5rem;
    height: 4.5rem;
    flex: 0 0 auto;
    place-items: center;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-xl);
    background: var(--surface-2);
    font-size: 2rem;
  }

  .hobby-header .eyebrow {
    margin-bottom: 0.25rem;
  }

  h1 {
    font-size: clamp(2rem, 1.5rem + 2.4vw, 3.6rem);
    line-height: 1.2;
    letter-spacing: -0.035em;
    overflow-wrap: anywhere;
  }

  .hobby-lead {
    margin-top: 2rem;
    color: var(--muted);
    font-size: clamp(1.25rem, 1.1rem + 0.8vw, 1.7rem);
    line-height: 1.6;
    animation: rise 800ms var(--ease-out) 120ms both;
  }

  .hobby-detail {
    display: grid;
    gap: 1.25rem;
    margin-top: 2.5rem;
    padding-top: 2.5rem;
    border-top: 1px solid var(--line);
    font-size: clamp(1rem, 0.96rem + 0.2vw, 1.1rem);
    line-height: 2;
  }

  .hobby-aside {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 3rem;
    padding: 1.5rem;
  }

  .hobby-aside p {
    color: var(--muted);
  }

  @media (max-width: 30rem) {
    .hobby-header {
      align-items: flex-start;
    }

    .hobby-icon {
      width: 3.75rem;
      height: 3.75rem;
    }
  }
</style>
