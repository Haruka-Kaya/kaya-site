---
import { ClientRouter } from 'astro:transitions';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { absoluteUrl } from '../lib/site';
import { alternateLang, localizePath, useTranslations, type Lang } from '../i18n/ui';
import '../styles/global.css';

interface Props {
  lang: Lang;
  title: string;
  description: string;
  path: string;
  alternatePath?: string | null;
  ogType?: string;
  settings: {
    name: string;
    github: string;
    hackerone: string;
    email: string;
    twitter: string;
  };
  progress?: boolean;
}

const { lang, title, description, path, alternatePath = path, ogType = 'website', settings, progress = false } = Astro.props;
const t = useTranslations(lang);
const other = alternateLang(lang);

const canonical = absoluteUrl(localizePath(path, lang), Astro.site, Astro.url.origin);
const alternateUrl = alternatePath ? absoluteUrl(localizePath(alternatePath, other), Astro.site, Astro.url.origin) : null;
const socialImage = absoluteUrl('/og.png', Astro.site, Astro.url.origin);
const socialImageAlt = `${settings.name} — Security Research & Systems Building`;
const themeColor = '#0b1411';
---

<!doctype html>
<html lang={lang} class="no-js">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="description" content={description} />
    <meta name="theme-color" content={themeColor} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang={lang === 'ja' ? 'ja' : 'en'} href={canonical} />
    {alternateUrl && <link rel="alternate" hreflang={other === 'ja' ? 'ja' : 'en'} href={alternateUrl} />}
    {alternateUrl && <link rel="alternate" hreflang="x-default" href={lang === 'ja' ? canonical : alternateUrl} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@400;500;700&family=Instrument+Serif:ital@0;1&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />

    <meta property="og:type" content={ogType} />
    <meta property="og:locale" content={lang === 'ja' ? 'ja_JP' : 'en_US'} />
    <meta property="og:site_name" content={settings.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={socialImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <meta name="twitter:image:alt" content={socialImageAlt} />

    <title>{title}</title>
    <script is:inline>
      (function () {
        var theme = null;
        try {
          theme = localStorage.getItem('theme');
        } catch (e) {}
        if (theme !== 'light' && theme !== 'dark') {
          theme = window.matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';
        }
        document.documentElement.setAttribute('data-theme', theme);
        document.documentElement.classList.remove('no-js');
      })();
    </script>
    <ClientRouter />
    <slot name="head" />
  </head>
  <body id="top">
    <a class="skip-link" href="#main-content">{t('skip')}</a>
    {progress && <div class="progress" aria-hidden="true"><span data-progress></span></div>}
    <Nav lang={lang} name={settings.name} alternatePath={alternatePath} />
    <slot />
    <Footer lang={lang} settings={settings} />
    <script>
      import '../scripts/motion.ts';
    </script>
  </body>
</html>

<style>
  .progress {
    position: fixed;
    z-index: 60;
    top: 0;
    left: 0;
    width: 100%;
    height: 3px;
    pointer-events: none;
  }

  .progress span {
    display: block;
    height: 100%;
    background: var(--signal);
    transform: scaleX(0);
    transform-origin: left;
  }
</style>
