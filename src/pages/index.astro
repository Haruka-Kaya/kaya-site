---
export const prerender = true;

import { createReader } from '@keystatic/core/reader';
import keystaticConfig from '../../keystatic.config';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import About from '../components/About.astro';
import SecurityResearch from '../components/SecurityResearch.astro';
import HobbyCard from '../components/HobbyCard.astro';
import ProjectCard from '../components/ProjectCard.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

const reader = createReader(process.cwd(), keystaticConfig);

const [about, settings, allHobbies, allProjects] = await Promise.all([
  reader.singletons.about.read(),
  reader.singletons.settings.read(),
  reader.collections.hobbies.all(),
  reader.collections.projects.all(),
]);

if (!about) {
  throw new Error('Failed to read singleton "about" (src/content/singletons/about.yaml).');
}
if (!settings) {
  throw new Error('Failed to read singleton "settings" (src/content/singletons/settings.yaml).');
}

const likeSlugs = ['fpvdrone', 'electronics', 'security', 'aiagents', 'skiing'];
const projectSlugs = ['authorized-research-platform', 'attendance-system', 'jiyu-kenkyu-ai', 'zeroterm'];

const missingLikes = likeSlugs.filter((slug) => !allHobbies.some((item) => item.slug === slug));
const missingProjects = projectSlugs.filter((slug) => !allProjects.some((item) => item.slug === slug));
if (missingLikes.length > 0 || missingProjects.length > 0) {
  const missing = [
    ...missingLikes.map((slug) => 'hobbies/' + slug),
    ...missingProjects.map((slug) => 'projects/' + slug),
  ];
  throw new Error('Curated slugs not found in content: ' + missing.join(', '));
}

const likes = allHobbies
  .filter((item) => likeSlugs.includes(item.slug))
  .sort((a, b) => likeSlugs.indexOf(a.slug) - likeSlugs.indexOf(b.slug));

const projects = allProjects
  .filter((item) => projectSlugs.includes(item.slug))
  .sort((a, b) => projectSlugs.indexOf(a.slug) - projectSlugs.indexOf(b.slug));

const name = settings?.name ?? '賀屋 悠';
const siteTitle = settings?.site_title ?? `${name} | 自己紹介`;
const github = settings?.github ?? 'https://github.com/Haruka-Kaya';
const hackerone = settings?.hackerone ?? 'https://hackerone.com/haruka-kaya';
const description = about?.tagline ?? 'ドローンを飛ばしたり、Linuxを触ったり、思いついたものを作ったりしています。';
const avatar = about?.avatar || 'https://github.com/Haruka-Kaya.png?size=420';
const canonical = new URL('/', Astro.site ?? Astro.url.origin);
const socialImage = new URL('/og.png', Astro.site ?? Astro.url.origin);

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name,
  url: canonical.toString(),
  image: avatar,
  sameAs: [github, settings?.twitter, hackerone].filter(Boolean),
};
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f3efe5" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@400;500;600;700&display=swap" rel="stylesheet" />

    <meta property="og:type" content="profile" />
    <meta property="og:locale" content="ja_JP" />
    <meta property="og:title" content={siteTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${name} — Security Research & Systems Building`} />
    <meta property="profile:first_name" content="悠" />
    <meta property="profile:last_name" content="賀屋" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={siteTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <meta name="twitter:image:alt" content={`${name} — Security Research & Systems Building`} />

    <title>{siteTitle}</title>
    <script type="application/ld+json" set:html={JSON.stringify(personSchema)}></script>
  </head>
  <body id="top">
    <a class="skip-link" href="#main-content">本文へ移動</a>
    <Nav name={name} github={github} />

    <main id="main-content">
      <Hero name={name} tagline={description} avatar={avatar} hackerone={hackerone} />
      <SecurityResearch hackerone={hackerone} />
      <section id="projects" class="projects" aria-labelledby="projects-title">
        <div class="container">
          <div class="section-header section-header--projects">
            <div>
              <p class="eyebrow">研究とものづくり</p>
              <h2 id="projects-title" class="section-heading">調べるための道具も、自分で作る。</h2>
            </div>
            <p class="section-intro">
              セキュリティ調査のための仕組みから、身近な人が使う小さな道具まで。
              実際に動かしながら、少しずつ育てています。
            </p>
          </div>

          <div class="project-list">
            {projects.map((item, index) => (
              <ProjectCard
                name={item.entry.name}
                description={item.entry.description ?? ''}
                url={item.entry.url ?? ''}
                tags={item.entry.tags ?? []}
                number={index + 1}
              />
            ))}
          </div>

          <p class="github-note">
            ほかにも試作したものを
            <a class="text-link" href={github} target="_blank" rel="noopener noreferrer">
              GitHub<span class="sr-only">（新しいタブで開きます）</span>
            </a>
            に置いています。
          </p>
        </div>
      </section>

      <About bio={about?.bio ?? ''} location={about?.location ?? ''} />

      <section id="likes" class="likes" aria-labelledby="likes-title">
        <div class="container">
          <div class="section-header">
            <div>
              <p class="eyebrow">好きなこと</p>
              <h2 id="likes-title" class="section-heading">画面の外でも、仕組みを触る。</h2>
            </div>
            <p class="section-intro">
              ドローン、Linux、電子工作、AI、スキー。
              ひとつの興味から次へ、手を動かしながら広がってきました。
            </p>
          </div>

          <div class="likes-grid">
            {likes.map((item, index) => (
              <div class="like-item">
                <HobbyCard
                  name={item.entry.name}
                  description={item.entry.description ?? ''}
                  icon={item.entry.icon ?? ''}
                  slug={item.slug}
                  index={index + 1}
                />
              </div>
            ))}
          </div>
        </div>
      </section>
    </main>

    <Footer
      name={name}
      github={github}
      email={settings?.email ?? ''}
      twitter={settings?.twitter ?? ''}
      hackerone={hackerone}
    />
  </body>
</html>

<style>
  .likes,
  .projects {
    padding-block: clamp(4.5rem, 9vw, 7.5rem);
  }

  .projects {
    border-block: 1px solid var(--line);
    background: var(--paper);
  }

  .section-header {
    display: grid;
    gap: 1.5rem;
    margin-bottom: 2.75rem;
  }

  .likes-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1rem;
  }

  .like-item {
    min-width: 0;
  }

  .like-item:last-child {
    grid-column: 1 / -1;
  }

  .project-list {
    border-bottom: 1px solid var(--line);
  }

  .github-note {
    margin: 1.5rem 0 0;
    color: var(--muted);
  }

  @media (min-width: 40rem) {
    .likes-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 48rem) {
    .section-header {
      grid-template-columns: minmax(0, 1fr) minmax(18rem, 0.85fr);
      align-items: end;
      gap: 4rem;
    }

    .section-intro {
      margin: 0;
    }
  }

  @media (min-width: 64rem) {
    .likes-grid {
      grid-template-columns: repeat(6, minmax(0, 1fr));
    }

    .like-item:nth-child(-n + 3) {
      grid-column: span 2;
    }

    .like-item:nth-child(4),
    .like-item:nth-child(5) {
      grid-column: span 3;
    }
  }
</style>
