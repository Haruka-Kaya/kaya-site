---
export const prerender = true;

import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import About from '../components/About.astro';
import SecurityResearch from '../components/SecurityResearch.astro';
import HobbyCard from '../components/HobbyCard.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { reader, resolveSettings, sortBySlugOrder, absoluteUrl } from '../lib/site';

const [about, settings, allHobbies, allProjects] = await Promise.all([
  reader.singletons.about.read(),
  reader.singletons.settings.read(),
  reader.collections.hobbies.all(),
  reader.collections.projects.all(),
]);

const likeSlugs = ['fpvdrone', 'electronics', 'security', 'aiagents', 'skiing'];
const projectSlugs = ['authorized-research-platform', 'attendance-system', 'jiyu-kenkyu-ai', 'zeroterm'];

const likes = sortBySlugOrder(allHobbies, likeSlugs);
const projects = sortBySlugOrder(allProjects, projectSlugs);

const { name, siteTitle, github, hackerone, email, twitter } = resolveSettings(settings);
const description = about?.tagline ?? 'ドローンを飛ばしたり、Linuxを触ったり、思いついたものを作ったりしています。';
const avatar = about?.avatar || 'https://github.com/Haruka-Kaya.png?size=420';

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name,
  url: absoluteUrl('/', Astro.site, Astro.url.origin).toString(),
  image: avatar,
  sameAs: [github, twitter, hackerone].filter(Boolean),
};
---

<BaseLayout
  title={siteTitle}
  description={description}
  path="/"
  ogType="profile"
  name={name}
  github={github}
  hackerone={hackerone}
  email={email}
  twitter={twitter}
>
  <Fragment slot="head">
    <meta property="profile:first_name" content="悠" />
    <meta property="profile:last_name" content="賀屋" />
    <script type="application/ld+json" set:html={JSON.stringify(personSchema)}></script>
  </Fragment>

  <main id="main-content">
    <Hero name={name} tagline={description} avatar={avatar} hackerone={hackerone} />
    <SecurityResearch hackerone={hackerone} />
    <section id="projects" class="projects" aria-labelledby="projects-title">
      <div class="container">
        <div class="section-header section-header--projects">
          <div>
            <p class="eyebrow">研究とものづくり</p>
            <h2 id="projects-title" class="section-heading">調べるための道具も、自分で作る。</h2>
          </div>
          <p class="section-intro">
            セキュリティ調査のための仕組みから、身近な人が使う小さな道具まで。
            実際に動かしながら、少しずつ育てています。
          </p>
        </div>

        <div class="project-list">
          {projects.map((item, index) => (
            <ProjectCard
              name={item.entry.name}
              description={item.entry.description ?? ''}
              url={item.entry.url ?? ''}
              tags={item.entry.tags ?? []}
              number={index + 1}
            />
          ))}
        </div>

        <p class="github-note">
          ほかにも試作したものを
          <a class="text-link" href={github} target="_blank" rel="noopener noreferrer">
            GitHub<span class="sr-only">（新しいタブで開きます）</span>
          </a>
          に置いています。
        </p>
      </div>
    </section>

    <About bio={about?.bio ?? ''} location={about?.location ?? ''} />

    <section id="likes" class="likes" aria-labelledby="likes-title">
      <div class="container">
        <div class="section-header">
          <div>
            <p class="eyebrow">好きなこと</p>
            <h2 id="likes-title" class="section-heading">画面の外でも、仕組みを触る。</h2>
          </div>
          <p class="section-intro">
            ドローン、Linux、電子工作、AI、スキー。
            ひとつの興味から次へ、手を動かしながら広がってきました。
          </p>
        </div>

        <div class="likes-grid">
          {likes.map((item, index) => (
            <div class="like-item">
              <HobbyCard
                name={item.entry.name}
                description={item.entry.description ?? ''}
                icon={item.entry.icon ?? ''}
                slug={item.slug}
                index={index + 1}
              />
            </div>
          ))}
        </div>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .likes,
  .projects {
    padding-block: clamp(4.5rem, 9vw, 7.5rem);
  }

  .projects {
    border-block: 1px solid var(--line);
    background: var(--paper);
  }

  .section-header {
    display: grid;
    gap: 1.5rem;
    margin-bottom: 2.75rem;
  }

  .likes-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1rem;
  }

  .like-item {
    min-width: 0;
  }

  .like-item:last-child {
    grid-column: 1 / -1;
  }

  .project-list {
    border-bottom: 1px solid var(--line);
  }

  .github-note {
    margin: 1.5rem 0 0;
    color: var(--muted);
  }

  @media (min-width: 40rem) {
    .likes-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 48rem) {
    .section-header {
      grid-template-columns: minmax(0, 1fr) minmax(18rem, 0.85fr);
      align-items: end;
      gap: 4rem;
    }

    .section-intro {
      margin: 0;
    }
  }

  @media (min-width: 64rem) {
    .likes-grid {
      grid-template-columns: repeat(6, minmax(0, 1fr));
    }

    .like-item:nth-child(-n + 3) {
      grid-column: span 2;
    }

    .like-item:nth-child(4),
    .like-item:nth-child(5) {
      grid-column: span 3;
    }
  }
</style>
