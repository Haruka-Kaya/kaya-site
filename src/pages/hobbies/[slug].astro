---
export const prerender = true;

import BaseLayout from '../../layouts/BaseLayout.astro';
import { reader, resolveSettings } from '../../lib/site';

export async function getStaticPaths() {
  const slugs = await reader.collections.hobbies.list();
  return slugs.map((slug) => ({ params: { slug } }));
}

const { slug } = Astro.params;
const [hobby, settings] = await Promise.all([
  reader.collections.hobbies.read(slug!),
  reader.singletons.settings.read(),
]);

if (!hobby) return Astro.redirect('/');

const { name, github, hackerone, email, twitter } = resolveSettings(settings);
const displayName = typeof hobby.name === 'string' ? hobby.name : (hobby.name as { name?: string })?.name ?? slug;
const description = hobby.description ?? `${name}が好きなこと`;
const pageTitle = `${displayName} | ${name}`;
---

<BaseLayout
  title={pageTitle}
  description={description}
  path={`/hobbies/${slug}`}
  ogType="article"
  name={name}
  github={github}
  hackerone={hackerone}
  email={email}
  twitter={twitter}
>
  <main id="main-content" class="hobby-page">
    <article class="container hobby-article">
      <a href="/#likes" class="back-link">
        好きなこと一覧へ
      </a>

      <header class="hobby-header">
        <span class="hobby-icon" aria-hidden="true">{hobby.icon}</span>
        <div>
          <p class="eyebrow">好きなこと</p>
          <h1>{displayName}</h1>
        </div>
      </header>

      <p class="hobby-lead">{description}</p>

      {hobby.detail && (
        <div class="hobby-detail">
          <p>{hobby.detail}</p>
        </div>
      )}

      <aside class="hobby-aside">
        <p>ほかの好きなことも、トップページにまとめています。</p>
        <a class="button button--secondary" href="/#likes">一覧を見る</a>
      </aside>
    </article>
  </main>
</BaseLayout>

<style>
  .hobby-page {
    padding-block: clamp(3.5rem, 8vw, 6.5rem);
  }

  .hobby-article {
    max-width: 52rem;
  }

  .back-link {
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    gap: 0.5rem;
    color: var(--accent-strong);
    font-weight: 700;
  }

  .back-link::before {
    content: "←";
  }

  .hobby-header {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    margin-top: 2.75rem;
  }

  .hobby-icon {
    display: grid;
    width: 4.5rem;
    height: 4.5rem;
    flex: 0 0 auto;
    place-items: center;
    border-radius: var(--radius-xl);
    background: var(--accent-soft);
    font-size: 2rem;
  }

  .hobby-header .eyebrow {
    margin-bottom: 0.25rem;
  }

  h1 {
    margin: 0;
    font-size: clamp(2rem, 1.65rem + 1.5vw, 3.4rem);
    line-height: 1.35;
    letter-spacing: -0.035em;
    overflow-wrap: anywhere;
  }

  .hobby-lead {
    margin: 2rem 0 0;
    font-size: clamp(1.05rem, 1rem + 0.25vw, 1.2rem);
    font-weight: 600;
    line-height: 1.9;
  }

  .hobby-detail {
    margin-top: 2rem;
    padding-top: 2rem;
    border-top: 1px solid var(--line);
  }

  .hobby-detail p {
    margin: 0;
    white-space: pre-line;
    line-height: 2;
  }

  .hobby-aside {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 3rem;
    padding: 1.25rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-xl);
    background: var(--paper);
  }

  .hobby-aside p {
    margin: 0;
    color: var(--muted);
  }

  @media (max-width: 30rem) {
    .hobby-header {
      align-items: flex-start;
    }

    .hobby-icon {
      width: 3.75rem;
      height: 3.75rem;
    }
  }
</style>
